from PIL import Image
import random
pic = Image.open(r'C:\Users\titop\Desktop\screenshot\{4A61F1FE-3A04-4819-9C29-683823B3EBD8}.png').convert('RGB')
pixels = pic.load()
z = random.randrange(1, 4)
for y in range(pic.size[1]):
    for x in range(pic.size[0]):
        r, g, b = pixels[x, y]
        priemer = (r + g + b) // 3
        if z == 1:
            pixels[x, y] = (priemer, 0, 0)
        elif z == 2:
            pixels[x, y] = (0, priemer, 0)
        elif z == 3:
            pixels[x, y] = (0, 0, priemer)
pic.show()

